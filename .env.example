# Required Environment Variables
# Copy this file to .env.local and fill in your values

# Admin Authentication
# Generate hash: node -e "require('bcryptjs').hash('YOUR_PASSWORD',10).then(console.log)"
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Session Secret (random 32+ char string)
SESSION_SECRET=your_super_secret_session_key_here_minimum_32_chars

# Vercel Postgres (auto-filled by Vercel when you connect a Postgres database)
POSTGRES_URL=your_postgres_url
POSTGRES_PRISMA_URL=your_postgres_prisma_url
POSTGRES_URL_NO_SSL=your_postgres_url_no_ssl
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling
POSTGRES_USER=your_postgres_user
POSTGRES_HOST=your_postgres_host
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=your_postgres_database

# Vercel Blob (auto-filled by Vercel when you connect Blob storage)
BLOB_READ_WRITE_TOKEN=your_blob_token

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
